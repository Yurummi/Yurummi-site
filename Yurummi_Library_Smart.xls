<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#1E293B"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <Style ss:ID="TitleStyle">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="16" ss:Bold="1" ss:Color="#0F172A"/>
  </Style>
  <Style ss:ID="SubtitleStyle">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Italic="1" ss:Color="#64748B"/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#0F172A"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#1E293B" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="HeaderPink">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#D91B68" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="HeaderCyan">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#0284C7" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="CardHeader">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="11" ss:Bold="1" ss:Color="#0F172A"/>
   <Interior ss:Color="#F1F5F9" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="StatNum">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="14" ss:Bold="1" ss:Color="#D91B68"/>
  </Style>
  <Style ss:ID="DataCell">
   <Alignment ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="DataCenter">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="MasterpieceCell">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#B45309"/>
   <Interior ss:Color="#FEF3C7" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#FDE68A"/>
   </Borders>
  </Style>
  <Style ss:ID="WatchingCell">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#0369A1"/>
   <Interior ss:Color="#E0F2FE" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#BAE6FD"/>
   </Borders>
  </Style>
  <Style ss:ID="WatchedCell">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#047857"/>
   <Interior ss:Color="#D1FAE5" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#A7F3D0"/>
   </Borders>
  </Style>
 </Styles>
 <Worksheet ss:Name="📊 Главный Дэшборд">
  <Table ss:DefaultRowHeight="20">
   <Column ss:Width="30"/>
   <Column ss:Width="250"/>
   <Column ss:Width="130"/>
   <Column ss:Width="320"/>
   <Row ss:Height="30">
    <Cell ss:Index="2" ss:StyleID="TitleStyle"><Data ss:Type="String">⚡ БИБЛИОТЕКА YURUMMI — СВОДНЫЙ ДЭШБОРД</Data></Cell>
   </Row>
   <Row ss:Height="18">
    <Cell ss:Index="2" ss:StyleID="SubtitleStyle"><Data ss:Type="String">Интерактивная статистика медиатеки и игрового профиля Yurummi</Data></Cell>
   </Row>
   <Row ss:Height="10"/>
   <Row ss:Height="24">
    <Cell ss:Index="2" ss:StyleID="CardHeader"><Data ss:Type="String">Показатель</Data></Cell>
    <Cell ss:StyleID="CardHeader"><Data ss:Type="String">Количество</Data></Cell>
    <Cell ss:StyleID="CardHeader"><Data ss:Type="String">Пояснение / Источник</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">👑 Шедевры 100+ (Зал Славы)</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">20</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Тайтлы с наивысшей оценкой Yurummi (100+ баллов)</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">🔥 Онгоинги (Смотрю прямо сейчас)</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">22</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Активные тайтлы текущего сезона</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">🎌 Всего аниме в каталоге</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">332</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Лист «🎌 Аниме и Онгоинги»</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">🎬 Просмотренные фильмы с оценкой</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">61</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Лист «🎬 Фильмы (Просмотрено)»</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">🍿 Полка «Хочу глянуть» (Бэклог)</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">316</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Лист «🍿 Полка (Хочу глянуть)»</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">🦸‍♂️ Фильмы и сериалы Marvel &amp; DC</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">65</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Лист «🦸‍♂️ Marvel и DC» (Хронологический порядок)</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">🎮 Всего игр в Steam</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">313</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Лист «🎮 Steam Игры» (Уровень Steam 37)</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">🏆 Идеально пройденных игр (100% ачивок)</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">25</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Игры с полным закрытием всех достижений</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">💬 Написанных обзоров в Steam</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">12</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Рецензии Юрумми с оценкой в Steam</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="DataCell"><Data ss:Type="String">🔥 Часов в Dota 2</Data></Cell>
    <Cell ss:StyleID="StatNum"><Data ss:Type="Number">13081</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Абсолютный рекорд игрового времени</Data></Cell>
   </Row>
   <Row ss:Height="16"/>
   <Row ss:Height="24">
    <Cell ss:Index="2" ss:StyleID="HeaderPink"><Data ss:Type="String">Шкала эмоций Yurummi</Data></Cell>
    <Cell ss:StyleID="HeaderPink"><Data ss:Type="String">Баллы</Data></Cell>
    <Cell ss:StyleID="HeaderPink"><Data ss:Type="String">Значение шкалы</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:Index="2" ss:StyleID="MasterpieceCell"><Data ss:Type="String">👑 ШЕДЕВР</Data></Cell>
    <Cell ss:StyleID="MasterpieceCell"><Data ss:Type="String">100+</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Превзошло всё! Взрыв эмоций и восторг (Аркейн, Человек-паук, Твоё имя)</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:Index="2" ss:StyleID="DataCenter"><Data ss:Type="String">🚀 ВЫШЕ ОЖИДАНИЙ</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">20 – 90</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Очень крутой тайтл, подарил больше чем ждал</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:Index="2" ss:StyleID="WatchingCell"><Data ss:Type="String">⭐ БАЗА</Data></Cell>
    <Cell ss:StyleID="WatchingCell"><Data ss:Type="String">10</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Качественная база, выдало именно то, что нужно</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:Index="2" ss:StyleID="DataCenter"><Data ss:Type="String">👍 ХОРОШО</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">8 – 9.5</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Добротный просмотр на вечер</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:Index="2" ss:StyleID="DataCenter"><Data ss:Type="String">😐 ПРОХОДНЯК</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">5 – 7</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Средний уровень, можно глянуть фоном</Data></Cell>
   </Row>
  </Table>
 </Worksheet>
